{
  "name": "@pm/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Execution backend: the ONLY process that can place orders. Runs on the static-IP VM. See docs/04.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@pm/broker-dhan": "workspace:*",
    "@pm/broker-kite": "workspace:*",
    "@pm/core": "workspace:*",
    "fastify": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "pino": "^9.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}

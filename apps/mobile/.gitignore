# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Continuous Native Generation — `ios/` and `android/` are generated by
# `expo prebuild` on the operator's machine and are never committed. Do NOT run
# `expo prebuild --clean` on a tree that already has hand-managed native files
# (signing keys, GoogleService-Info.plist) — see README.
/ios
/android

# Native artefacts / signing material
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Firebase service files — the operator supplies these (README §Service files).
google-services.json
GoogleService-Info.plist

# Metro
.metro-health-check*

# tests
coverage/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

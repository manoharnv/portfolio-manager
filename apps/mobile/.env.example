# apps/mobile — copy to `.env` and fill in. `.env` is gitignored (docs/00 §0.7.7).
# Every value below is a PUBLIC identifier: a Firebase web config identifies a
# project, it does not authorise anything. Access control is firestore.rules +
# the backend's ALLOWED_UIDS. No broker key, no service account, no secret of
# any kind belongs in this file or in the app bundle.

# --- Execution backend (docs/04). No trailing slash. -------------------------
EXPO_PUBLIC_BACKEND_BASE_URL=https://api.example.com

# --- Firebase web config (Console → Project settings → Your apps → Web) ------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy-replace-me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- Google Sign-In (Console → Project settings → OAuth client ids) ----------
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=000000000000-ios.apps.googleusercontent.com
# Reverse-DNS form of the iOS client id — required by the google-signin plugin.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.000000000000-ios

# --- App identity (placeholders; set before any real build) ------------------
EXPO_PUBLIC_IOS_BUNDLE_ID=com.example.portfoliomanager
EXPO_PUBLIC_ANDROID_PACKAGE=com.example.portfoliomanager

# --- Broker daily login -----------------------------------------------------
# FALLBACKS ONLY. The live URL comes from POST /v1/auth/:broker/login-url,
# because only the backend holds the broker api key. Leave blank unless you are
# testing the degraded path.
EXPO_PUBLIC_BROKER_LOGIN_URL_KITE=
EXPO_PUBLIC_BROKER_LOGIN_URL_DHAN=
# Must match the redirect registered in the broker's developer console.
EXPO_PUBLIC_BROKER_REDIRECT_URL=pm://broker-callback

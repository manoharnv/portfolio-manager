{
  "name": "@pm/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "The human-in-the-loop control surface: review proposals, approve orders, hold the kill switch.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "lint": "eslint .",
    "build": "expo export --platform ios --platform android --output-dir dist",
    "clean": "rm -rf dist .expo .turbo coverage"
  },
  "dependencies": {
    "@pm/core": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/messaging": "^26.4.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "expo": "~57.0.22",
    "expo-apple-authentication": "~57.0.2",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.11",
    "eslint": "^10.10.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "jest",
        "@types/jest"
      ]
    }
  }
}

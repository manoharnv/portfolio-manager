{
  "name": "portfolio-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Human-in-the-loop portfolio automation system for Indian markets",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",

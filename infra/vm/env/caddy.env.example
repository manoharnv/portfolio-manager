# infra/vm/env/caddy.env.example
#
# NOT one of the two application env files — this feeds the Caddy reverse
# proxy (infra/vm/Caddyfile), which needs `{$PM_DOMAIN}` and
# `{$PM_BACKEND_PORT}` from its own process environment. The official Caddy
# apt package's systemd unit has no `EnvironmentFile=` by default, so
# bootstrap.sh installs a small drop-in
# (`/etc/systemd/system/caddy.service.d/pm-env.conf`) that adds
# `EnvironmentFile=/etc/pm/caddy.env` pointing here.
#
# Copy to /etc/pm/caddy.env (bootstrap.sh does this automatically on first
# boot if absent). Contains no secrets — mode 0644, root-owned is fine.

# Public hostname Caddy requests a Let's Encrypt certificate for. Must
# already resolve (DNS A record) to this VM's reserved static IP before
# Caddy starts, or the ACME HTTP-01 challenge fails. Matches Terraform's
# `var.domain` (bootstrap.sh seeds this from the `pm-domain` instance
# metadata key set in infra/terraform/vm.tf).
PM_DOMAIN=pm.example.com

# Must equal PORT in /etc/pm/backend.env — Caddy reverse-proxies HTTPS
# traffic on 443 to 127.0.0.1:$PM_BACKEND_PORT (docs/08 §8.2: "Backend
# listens only on the proxy; no direct public port besides 443").
PM_BACKEND_PORT=8080

# infra/vm/env/strategy.env.example
#
# Copy to /etc/pm/strategy.env on the VM (bootstrap.sh does this
# automatically on first boot if the file is absent), then fill in the real
# values. Mode 0600, owned by the `pm-strategy` OS user — it is the
# EnvironmentFile for pm-strategy.service (infra/vm/pm-strategy.service).
#
# Every variable here is read by `readEnv` in apps/strategy/src/index.ts.
# This process has NO broker order credentials and NO env var here ever
# names an order/token secret (dhan-access-token, kite-access-token,
# *-api-secret) — only PM_BROKER_SECRET, which points at the separate
# READ-ONLY credentials bundle (see infra/terraform/secrets.tf
# `pm-strategy-read-creds`). Enforced by docs/05 §5.1 at the code level and
# by infra/vm/nftables-strategy-egress.conf at the network level.

# --- Identity --------------------------------------------------------------
# REQUIRED. The single Firebase Auth uid this engine instance writes
# proposals/audit events for (docs/01 §1.3: single-user / immediate family).
# `main()` throws and refuses to start without this.
PM_UID=

# --- Broker read credentials -------------------------------------------
# REQUIRED. The FULL Secret Manager resource name (not just the secret id!)
# of the read-creds secret, e.g.:
#   projects/<GCP_PROJECT_NUMBER_OR_ID>/secrets/pm-strategy-read-creds/versions/latest
# `loadSecret()` in apps/strategy/src/index.ts passes this straight to
# `SecretManagerServiceClient.accessSecretVersion({ name })` — unlike the
# backend's config.ts vars above, this is NOT a bare secret id.
#
# The secret's payload must be JSON matching @pm/core's `BrokerCreds` shape:
#   {"broker":"dhan","dhan":{"clientId":"...","accessToken":"...","expiresAt":"2026-01-01T00:00:00.000Z"}}
# or
#   {"broker":"kite","kite":{"apiKey":"...","accessToken":"...","expiresAt":"2026-01-01T00:00:00.000Z"}}
# See infra/README.md Phase 0 for how to add this secret's value.
# Full Secret Manager VERSION resource name (the engine calls accessSecretVersion on it), e.g.
# projects/<PROJECT_ID>/secrets/pm-strategy-read-creds/versions/latest
PM_BROKER_SECRET=

# --- Instrument master ------------------------------------------------------
# REQUIRED. CSV URL for the active broker's instrument/scrip master.
#   Dhan:  https://images.dhan.co/api-data/api-scrip-master.csv
#   Kite:  https://api.kite.trade/instruments
# Must match the broker named in the PM_BROKER_SECRET payload's "broker"
# field. Both hosts are pre-allowlisted in
# infra/vm/nftables-strategy-egress.conf regardless of which one you use.
# Dhan: https://images.dhan.co/api-data/api-scrip-master.csv   Kite: https://api.kite.trade/instruments
PM_INSTRUMENTS_URL=

# --- Market calendar --------------------------------------------------------
# Comma-separated ISO YYYY-MM-DD NSE holiday dates. Empty by default — docs/11
# §11.4 #1: ticks otherwise fire on holidays and write proposals that can
# never pass the market-hours guardrail. Must mirror backend.env's
# MARKET_HOLIDAYS.
PM_HOLIDAYS=

# --- Scheduling --------------------------------------------------------
# Minutes between intraday ticks. docs/11 §11.4 #6: price-taking strategies
# (DCA, rebalance) deliberately run on the intraday tick rather than
# pre-open/eod.
PM_INTRADAY_INTERVAL_MINUTES=5

# --- Logging -----------------------------------------------------------
# "true" for human-readable pino-pretty output (useful over
# `journalctl -u pm-strategy -f` interactively); anything else (including
# unset/empty) is structured JSON, the right default for Cloud Logging.
PM_PRETTY_LOGS=false

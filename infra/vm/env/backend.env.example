# infra/vm/env/backend.env.example
#
# Copy to /etc/pm/backend.env on the VM (bootstrap.sh does this automatically
# on first boot if the file is absent), then fill in the real values. Mode
# 0600, owned by the `pm-backend` OS user — it is the EnvironmentFile for
# pm-backend.service (infra/vm/pm-backend.service).
#
# Every variable here is read by `parseConfig` in apps/backend/src/config.ts.
# Values shown are that file's own defaults unless marked REQUIRED. This file
# NEVER contains a secret VALUE — only Secret Manager secret *names*; the
# actual broker keys/tokens are added with
# `gcloud secrets versions add <name> --data-file=-` (infra/README.md Phase 0).

# --- HTTP server -------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Keep in sync with PM_BACKEND_PORT in /etc/pm/caddy.env — Caddy reverse
# proxies to 127.0.0.1:$PM_BACKEND_PORT, so the two must match.

# --- Environment / logging ----------------------------------------------
# dry-run | paper | prod. Fail-closed default: dry-run (simulated fills,
# no broker call ever leaves the box). Do not set to prod until you've
# completed docs/11's VERIFY-LIVE checklist and the go-live checklist in
# infra/README.md.
ENVIRONMENT=dry-run
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- GCP / Firebase project ----------------------------------------------
# REQUIRED (parseConfig defaults both to "" but the backend cannot resolve
# Secret Manager or verify Firebase ID tokens without at least one of them
# set — see createSecretManagerStore's projectId fallback in index.ts).
GCP_PROJECT=
FIREBASE_PROJECT_ID=

# --- Secret Manager secret NAMES (not values) ----------------------------
# These must match secret_id values actually created by
# infra/terraform/secrets.tf. Defaults below match that file's
# `backend_secret_ids` list — only change these if you renamed a secret_id
# in Terraform to match.
DHAN_API_KEY_SECRET=dhan-api-key
DHAN_API_SECRET_SECRET=dhan-api-secret
DHAN_ACCESS_TOKEN_SECRET=dhan-access-token
DHAN_CLIENT_ID_SECRET=dhan-client-id
KITE_API_KEY_SECRET=kite-api-key
KITE_API_SECRET_SECRET=kite-api-secret
KITE_ACCESS_TOKEN_SECRET=kite-access-token

# --- Access control / audit -----------------------------------------------
# REQUIRED before ENVIRONMENT=prod. Comma-separated Firebase Auth uids.
# Empty denies every caller (fail closed) — parseConfig throws a ConfigError
# if this is empty AND ENVIRONMENT=prod.
ALLOWED_UIDS=
# REQUIRED before ENVIRONMENT=prod. The VM's own reserved static IP
# (infra/terraform output `static_ip`) — recorded on every order/audit event
# (orders.ipUsed). parseConfig throws if empty AND ENVIRONMENT=prod.
STATIC_IP=

# Where the downloaded instrument masters are cached for the strategy engine
# (it reads them via file:// instead of a CDN its egress allowlist cannot pin
# down — docs/11 §11.4 #8). bootstrap.sh creates the directory; leave empty to
# disable the cache.
INSTRUMENTS_CACHE_DIR=/var/lib/pm/instruments

# Secret Manager id of the strategy engine's READ-creds secret. The backend
# rewrites it after every broker login (token + expiry + active broker) so the
# engine's next start sees today's session. Empty = never sync.
STRATEGY_READ_CREDS_SECRET=pm-strategy-read-creds

# Where GET /v1/auth/dhan/redirect bounces the browser once Dhan's consent has
# been consumed (status=ok|error is appended). Must match the app's scheme
# (apps/mobile brokerRedirectUrl).
APP_CALLBACK_URL=pm://broker-callback

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# --- Background loop intervals (ms) ----------------------------------------
RECONCILE_INTERVAL_MS=15000
PORTFOLIO_REFRESH_INTERVAL_MS=60000
# dry-run/paper only: how long after submission the simulator fills an order.
SIMULATOR_FILL_AFTER_MS=2000
# A proposal parked in approved/placing longer than this is presumed
# abandoned/stuck (reconcile-adjacent housekeeping). 5 minutes.
STUCK_PROPOSAL_AFTER_MS=300000

# --- Market calendar --------------------------------------------------------
# Comma-separated ISO YYYY-MM-DD NSE holiday dates. Empty by default — docs/11
# §11.4 #1 flags this explicitly: an empty list means holidays are treated as
# trading days. Populate with the current NSE holiday calendar before going
# live; must also be mirrored into strategy.env's PM_HOLIDAYS.
# Comma-separated IST YYYY-MM-DD; the current year's list lives in infra/vm/env/nse-holidays-YYYY.txt
MARKET_HOLIDAYS=

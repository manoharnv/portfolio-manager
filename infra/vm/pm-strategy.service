# infra/vm/pm-strategy.service — docs/08 §8.2, docs/01 §1.3, docs/05 §5.1.
#
# Runs the Claude/deterministic strategy routines. No broker order
# credentials anywhere in its environment (strategy.env only ever names a
# READ-creds secret) and, at the network layer, this unit's Linux user
# (`pm-strategy`) is the one nftables restricts — see
# infra/vm/nftables-strategy-egress.conf: it literally cannot open a TCP
# connection to anything but DNS, the broker read/data hosts, Firestore,
# Secret Manager, and the GCE metadata server. It can write Firestore
# `proposals`/`auditLog` only (enforced by its own least-privilege identity
# where that's live — see infra/terraform/iam.tf's caveat about which SA is
# actually attached to the VM today).
#
# Installed to /etc/systemd/system/pm-strategy.service by bootstrap.sh.

[Unit]
Description=Portfolio manager — strategy engine (read-only, proposals-only, sandboxed)
Documentation=https://github.com/manoharnv/portfolio-manager/blob/main/docs/05-strategy-engine.md
After=network-online.target pm-egress-allowlist.service
Wants=network-online.target
# The nftables egress rules must exist before this process makes its first
# outbound call — see the timer/service pair that (re)populates them.
Requires=pm-egress-allowlist.service

[Service]
Type=simple
User=pm-strategy
Group=pm-strategy
WorkingDirectory=/opt/pm
EnvironmentFile=/etc/pm/strategy.env
# IPv4-only VM — same reason as pm-backend.service.
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/usr/bin/node apps/strategy/dist/index.js
Restart=always
RestartSec=5
TimeoutStopSec=30

# --- Sandboxing --------------------------------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# NOT MemoryDenyWriteExecute — same Node/V8 JIT caveat as pm-backend.service.

# Read-only /opt/pm; no ReadWritePaths — this process never writes local
# disk (Firestore + Secret Manager + broker HTTPS only), PrivateTmp=true
# covers anything transient.

[Install]
WantedBy=multi-user.target

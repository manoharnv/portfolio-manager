# infra/vm/pm-backend.service — docs/08 §8.2, docs/01 §1.3.
#
# The ONLY process on this box with broker order credentials and a network
# path to broker order endpoints. Runs as its own unprivileged OS user
# (`pm-backend`, no login shell) so a compromise of the strategy unit's
# process (separate user, separate systemd unit) cannot read this unit's
# memory, files, or environment.
#
# Installed to /etc/systemd/system/pm-backend.service by bootstrap.sh.

[Unit]
Description=Portfolio manager — execution backend (order-capable, static IP)
Documentation=https://github.com/manoharnv/portfolio-manager/blob/main/docs/04-execution-backend.md
After=network-online.target
Wants=network-online.target
# Caddy proxies to this unit; start order doesn't strictly matter (Caddy
# retries on connection refused) but this keeps `systemctl status` order sane.
Before=caddy.service

[Service]
Type=simple
User=pm-backend
Group=pm-backend
WorkingDirectory=/opt/pm
EnvironmentFile=/etc/pm/backend.env
# The VM has no IPv6 egress; without this Node tries every AAAA record first
# (ENETUNREACH, then falls back) on each connection to a dual-stack host.
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
ExecStart=/usr/bin/node apps/backend/dist/index.js
Restart=always
RestartSec=5
TimeoutStopSec=30

# --- Sandboxing (docs/08 §8.2: "isolated as separate systemd services /
# users"; docs/07 §7.3 layer 6 "network") -----------------------------------
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# NOT MemoryDenyWriteExecute — Node/V8's JIT needs writable+executable
# memory mappings; enabling this can crash or cripple the runtime.

# /opt/pm is read-only at runtime (ProtectSystem=strict). The ONE writable
# path is the instrument-master cache the backend refreshes for the strategy
# engine to read via file:// (INSTRUMENTS_CACHE_DIR in backend.env;
# apps/backend/src/instruments-cache.ts; docs/11 §11.4 #8). bootstrap.sh
# creates it owned by pm-backend, mode 0755. PrivateTmp=true still gives the
# unit an isolated /tmp for anything transient.
ReadWritePaths=/var/lib/pm/instruments

[Install]
WantedBy=multi-user.target

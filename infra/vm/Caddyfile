# infra/vm/Caddyfile — docs/08 §8.2 ("reverse proxy (caddy) → TLS
# termination, HSTS, :443 → backend"), docs/04 §4.9 ("Transport: HTTPS only
# ... HSTS").
#
# Installed to /etc/caddy/Caddyfile by bootstrap.sh. `{$PM_DOMAIN}` and
# `{$PM_BACKEND_PORT}` come from /etc/pm/caddy.env via the
# caddy.service.d/pm-env.conf systemd drop-in (see env/caddy.env.example) —
# the official Debian Caddy package's default unit already runs
# `caddy run --environ`, so these placeholders resolve from that
# environment automatically.

{$PM_DOMAIN} {
	# Automatic HTTPS: Caddy provisions/renews a Let's Encrypt cert for
	# $PM_DOMAIN via the ACME HTTP-01 challenge, which needs port 80
	# reachable from the internet (network.tf allows 80/443 to tag
	# "pm-api") and a DNS A record already pointing at the static IP
	# (infra/README.md Phase 0) before the first request.

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	# docs/04 §4.9 mentions no explicit body-size cap, but every request
	# this backend accepts is a small JSON control-plane call (execute /
	# reject / cancel / killswitch) — 64k is generous headroom, not a
	# guess at a real upload size.
	request_body {
		max_size 64KB
	}

	reverse_proxy 127.0.0.1:{$PM_BACKEND_PORT} {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/pm-access.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	encode zstd gzip
}
